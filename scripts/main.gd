extends Node2D

# Скрипт сцены Main
# В текущей модульной архитектуре логика разделена:
# 1. Player управляет своим движением (player.gd)
# 2. QuestItem (Телефон) сам отслеживает вход игрока и открывает дверь (quest_item.gd)
#
# Если вам потребуется централизованное управление сценой (музыка звонка, таймеры, затемнение экрана),
# этот скрипт послужит удобной точкой входа.

@onready var player: CharacterBody2D = $Player
@onready var quest_item: Area2D = $QuestItem
@onready var door: StaticBody2D = $Door

func _ready() -> void:
	print("--- Сцена запущена: Комната Даши Камариной ---")
	print("Тишина... В тёмной комнате раздаётся настойчивый звонок старого телефона.")
