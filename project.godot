; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KamdraaaGame"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

SoundManager="*res://scripts/sound_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
ClueManager="*res://scripts/clue_manager.gd"
ParanoiaManager="*res://scripts/paranoia_manager.gd"
InventoryManager="*res://scripts/inventory_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

