[node name="AboutText" type="RichTextLabel" parent="Modals/AboutDialog/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.82, 0.86, 0.94, 0.95)
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "[color=#00e5ff][b]Сюжет:[/b][/color]
Даша просыпается в незнакомой конспиративной квартире с жесточайшим похмельем. В ушах пульсирует кровь, дверь заперта на электронный замок, а в глубине комнаты настойчиво звонит стационарный телефон. Восстановите хронологию событий безумной ночи и выберитесь наружу!

[color=#ffaa33][b]Особенности:[/b][/color]
• [color=#00e5ff]Изометрическое исследование[/color] квартиры в приглушенном нуарном освещении.
• [color=#ff007f]Искажение реальности (Паранойя)[/color]: обычные бытовые предметы мерещатся следами спецоперации синдиката.
• [color=#00ff88]Интерактивное окружение[/color]: улики, телефонные переговоры и разблокировка дверей.

[color=#00e5ff][b]Управление:[/b][/color]
• [b]WASD / Стрелки[/b] — Плавное 8-направленное перемещение
• [b]E[/b] — Взаимодействие (поднять трубку, открыть дверь)
• [b]ESC[/b] — Пауза и меню сохранения
• [b]F5 / F9[/b] — Быстрое сохранение / Быстрая загрузка

[color=#7a889b]Движок: Godot Engine 4.7 • Версия 0.2.0 • Kamdraaa Studio[/color]"

[node name="BtnCloseAbout" type="Button" parent="Modals/AboutDialog/Margin/VBox"]
custom_minimum_size = Vector2(140, 38)
layout_mode = 2
size_flags_horizontal = 4
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_norm")
text = "Понятно"

[node name="ToastNotification" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -170.0
offset_top = -68.0
offset_right = 170.0
offset_bottom = -25.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_toast")

[node name="Margin" type="MarginContainer" parent="ToastNotification"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6

[node name="ToastLabel" type="Label" parent="ToastNotification/Margin"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 13
text = "💾 Игра успешно сохранена"
horizontal_alignment = 1
